<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="P_Hmi" Id="{c5a196f0-83cf-4324-867a-3ed5db03fbb1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Hmi
// Helper for the PID trainer screens Visu_Main and Visu_Lessons.
// Screen buttons write here; this program turns them into P_Loop settings.
// Call order in MAIN: P_Panel(); P_Hmi(); P_Cal(); P_Loop(); P_FanTest(); P_FanAO();
VAR
    // ---- Screen buttons (Tap = TRUE while pressed) ----
    bSPUp        : BOOL;                     // SP + 0.5 in
    bSPDown      : BOOL;                     // SP - 0.5 in
    bStepTest    : BOOL;                     // SP jumps between 4 and 7 in
    aLessonBtn   : ARRAY[1..6] OF BOOL;      // Lessons page, buttons 1 to 6
    aFaultBtn    : ARRAY[0..6] OF BOOL;      // Instructor faults A to F = 1 to 6, 0 = clear

    // ---- Shown on the screens ----
    nLesson      : INT;                      // Last lesson loaded, 0 = none
    rPVShow      : REAL;                     // Height clamped to the tube, in
    nBallDY      : INT;                      // Ball graphic offset, pixels (negative = up)
    nSPDY        : INT;                      // SP marker offset, pixels (negative = up)
    rPShare      : REAL;                     // Share of the fan output from P, %
    rIShare      : REAL;                     // Share from I, %
    rDShare      : REAL;                     // Share from D, %
    bFaultActive : BOOL;                     // A teaching fault is on (doesn't say which)

    // ---- Trend: Histogram elements draw these, oldest at [0], newest at [149] ----
    aTrendPV     : ARRAY[0..149] OF REAL;    // Ball height, in (same clamp as the ball graphic)
    aTrendSP     : ARRAY[0..149] OF REAL;    // Setpoint, in
    aTrendCV     : ARRAY[0..149] OF REAL;    // Fan output, %, averaged over each 0.2 s sample

    // ---- Version 2: flat P / I / D bars (Relative movement > Movement top-left > Y) ----
    nPBarDY      : INT;                      // Pixels the bar's top edge moves down. 0 = full bar, rBarPx = empty
    nIBarDY      : INT;
    nDBarDY      : INT;
    dwPColor     : DWORD;                    // Bar fill (Color variables > Fill color). Muted orange, brighter as it rises
    dwIColor     : DWORD;
    dwDColor     : DWORD;

    // ---- Version 2: alarm banner across the top ----
    bFlash       : BOOL;                     // Slow flash clock, 0.6 s on / 0.6 s off
    bBanner      : BOOL;                     // Show the banner (element Invisible = NOT P_Hmi.bBanner)
    sBanner      : STRING(48);               // Banner text (element text '%s', text variable P_Hmi.sBanner)
    dwBannerFill : DWORD;                    // Banner fill, flashes bright / dark red so the text stays readable

    // ---- Version 2: polyline trend (Absolute movement > Dynamic points) ----
    aPtsPV       : ARRAY[0..149] OF VisuElems.VisuStructPoint;   // PV line, screen pixels
    aPtsSP       : ARRAY[0..149] OF VisuElems.VisuStructPoint;   // SP step line
    aPtsCV       : ARRAY[0..149] OF VisuElems.VisuStructPoint;   // Fan % line, in its own strip under the PV card
    aPtsFill     : ARRAY[0..151] OF VisuElems.VisuStructPoint;   // Polygon under the PV line (PV points + 2 bottom corners)
    nTrendPts    : INT := 150;               // Number of points for aPtsPV / aPtsSP / aPtsCV
    nFillPts     : INT := 152;               // Number of points for aPtsFill

    // ---- Settings ----
    rTubePx      : REAL := 330.0;            // Tube graphic height on the screen, pixels
    rTubeIn      : REAL := 14.0;             // Tube graphic height, inches
    tTrendSample : TIME := T#200MS;          // 150 points x 0.2 s = 30 s on the trend
    rBarPx       : REAL := 200.0;            // Full P / I / D bar height, pixels
    aBarColor    : ARRAY[0..3] OF DWORD := [16#FF6E461E, 16#FFA06223, 16#FFD2801E, 16#FFFF9F1C];  // 0-25, 25-50, 50-75, 75-100 %
    nTrX0        : INT := 186;               // PV / SP plot area, left edge, screen px
    nTrY0        : INT := 76;                // top edge
    nTrW         : INT := 320;               // width (150 points across it)
    nTrH         : INT := 230;               // height = 0 to rTubeIn inches (fixed axis, never autoscale)
    nCvY0        : INT := 322;               // Fan % strip, top edge (same left edge and width)
    nCvH         : INT := 80;                // Fan % strip height = 0 to 100 %
    // If the lines show up shifted on the panel, the points are relative to the element:
    // write nTrX0, nTrY0 and nCvY0 online to move them, then put the good values here.

    // ---- Internal ----
    fbSPUp       : R_TRIG;
    fbSPDown     : R_TRIG;
    fbStep       : R_TRIG;
    aLessonEdge  : ARRAY[1..6] OF R_TRIG;
    aFaultEdge   : ARRAY[0..6] OF R_TRIG;
    k            : INT;
    rSum         : REAL;
    rIUse        : REAL;                     // I part counted in the bars (0 when Ti = 0)
    fbTrendTimer : TON;
    fbFlash      : TON;
    rCVSum       : REAL;                     // Fan % added up every scan between trend samples
    nCVCount     : INT;
    rDX          : REAL;                     // Pixels between trend points
    nBottom      : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 1. Setpoint buttons, 0.5 in per press (P_Loop limits SP to 3 to 13.5 in)
fbSPUp(CLK := bSPUp);
fbSPDown(CLK := bSPDown);
IF fbSPUp.Q THEN
    P_Loop.rSP := P_Loop.rSP + 0.5;
END_IF
IF fbSPDown.Q THEN
    P_Loop.rSP := P_Loop.rSP - 0.5;
END_IF

// 2. Step test: SP jumps between 4 and 7 in
fbStep(CLK := bStepTest);
IF fbStep.Q THEN
    IF P_Loop.rSP < 5.5 THEN
        P_Loop.rSP := 7.0;
    ELSE
        P_Loop.rSP := 4.0;
    END_IF
END_IF

// 3. Lessons: load the settings that show one classic problem
FOR k := 1 TO 6 DO
    aLessonEdge[k](CLK := aLessonBtn[k]);
    IF aLessonEdge[k].Q THEN
        nLesson := k;
        P_Loop.nScenario := 0;
        P_Loop.bAntiWindup := TRUE;
        P_Loop.rTd := 0.0;
        CASE k OF
        1:  // P only: offset
            P_Loop.rKp := 4.0;
            P_Loop.rTi := 0.0;
        2:  // Too much gain
            P_Loop.rKp := 15.0;
            P_Loop.rTi := 0.0;
        3:  // Slow and overshoots
            P_Loop.rKp := 1.5;
            P_Loop.rTi := 1.5;
        4:  // Windup
            P_Loop.rKp := 4.0;
            P_Loop.rTi := 2.0;
            P_Loop.bAntiWindup := FALSE;
        5:  // Noisy derivative
            P_Loop.rKp := 4.0;
            P_Loop.rTi := 4.0;
            P_Loop.rTd := 1.0;
        6:  // Good start (matches the P_Loop defaults; update both after tuning)
            P_Loop.rKp := 1.0;
            P_Loop.rTi := 4.0;
        END_CASE
        P_Loop.bResetIAE := TRUE;
    END_IF
END_FOR

// 4. Instructor faults: A to F = scenario 1 to 6, button 0 clears
FOR k := 0 TO 6 DO
    aFaultEdge[k](CLK := aFaultBtn[k]);
    IF aFaultEdge[k].Q THEN
        P_Loop.nScenario := k;
    END_IF
END_FOR
bFaultActive := P_Loop.nScenario <> 0;

// 5. Ball and SP marker positions for the tube graphic
rPVShow := LIMIT(0.0, P_Loop.rPV, rTubeIn);
nBallDY := -REAL_TO_INT(rPVShow / rTubeIn * rTubePx);
nSPDY := -REAL_TO_INT(LIMIT(0.0, P_Loop.rSP, rTubeIn) / rTubeIn * rTubePx);

// 6. Share of the fan output from P, I and D.
//    With Ti = 0 the I part is only the fixed bias, so the I bar shows 0 (integral is off).
IF P_Loop.rTi > 0.0 THEN
    rIUse := ABS(P_Loop.rI);
ELSE
    rIUse := 0.0;
END_IF
rSum := ABS(P_Loop.rP) + rIUse + ABS(P_Loop.rD);
IF rSum > 0.01 THEN
    rPShare := ABS(P_Loop.rP) / rSum * 100.0;
    rIShare := rIUse / rSum * 100.0;
    rDShare := ABS(P_Loop.rD) / rSum * 100.0;
ELSE
    rPShare := 0.0;
    rIShare := 0.0;
    rDShare := 0.0;
END_IF

// 7. Trend: every 0.2 s, move every point one place left and add the newest at the end.
//    (A ring buffer would be faster, but the Histogram draws [0] to [149] in order,
//    so the line would jump where the ring wraps.)
//    Fan % is the average over the 0.2 s (display smoothing only; the PID never sees it).
rCVSum := rCVSum + P_Loop.rCV;
nCVCount := nCVCount + 1;
fbTrendTimer(IN := NOT fbTrendTimer.Q, PT := tTrendSample);
IF fbTrendTimer.Q THEN
    FOR k := 0 TO 148 DO
        aTrendPV[k] := aTrendPV[k + 1];
        aTrendSP[k] := aTrendSP[k + 1];
        aTrendCV[k] := aTrendCV[k + 1];
    END_FOR
    aTrendPV[149] := rPVShow;
    aTrendSP[149] := P_Loop.rSP;
    aTrendCV[149] := rCVSum / INT_TO_REAL(MAX(nCVCount, 1));
    rCVSum := 0.0;
    nCVCount := 0;

    // 7b. Version 2: same arrays turned into screen points. Newest on the right.
    rDX := INT_TO_REAL(nTrW) / 149.0;
    nBottom := nTrY0 + nTrH;
    FOR k := 0 TO 149 DO
        aPtsPV[k].iX := nTrX0 + REAL_TO_INT(INT_TO_REAL(k) * rDX);
        aPtsPV[k].iY := nBottom - REAL_TO_INT(LIMIT(0.0, aTrendPV[k], rTubeIn) / rTubeIn * INT_TO_REAL(nTrH));
        aPtsSP[k].iX := aPtsPV[k].iX;
        aPtsSP[k].iY := nBottom - REAL_TO_INT(LIMIT(0.0, aTrendSP[k], rTubeIn) / rTubeIn * INT_TO_REAL(nTrH));
        aPtsCV[k].iX := aPtsPV[k].iX;
        aPtsCV[k].iY := nCvY0 + nCvH - REAL_TO_INT(LIMIT(0.0, aTrendCV[k], 100.0) / 100.0 * INT_TO_REAL(nCvH));
        aPtsFill[k] := aPtsPV[k];
    END_FOR
    aPtsFill[150].iX := aPtsPV[149].iX;   // down to the bottom right corner
    aPtsFill[150].iY := nBottom;
    aPtsFill[151].iX := aPtsPV[0].iX;     // and back along the bottom (the polygon closes itself)
    aPtsFill[151].iY := nBottom;
END_IF

// 8. Version 2 bars: height from the share, colour in 4 steps (0-25, 25-50, 50-75, 75-100 %).
//    REAL_TO_INT(share / 25 - 0.5) gives 0, 1, 2, 3 (LIMIT keeps 100 % in step 3).
nPBarDY := REAL_TO_INT((100.0 - LIMIT(0.0, rPShare, 100.0)) / 100.0 * rBarPx);
nIBarDY := REAL_TO_INT((100.0 - LIMIT(0.0, rIShare, 100.0)) / 100.0 * rBarPx);
nDBarDY := REAL_TO_INT((100.0 - LIMIT(0.0, rDShare, 100.0)) / 100.0 * rBarPx);
dwPColor := aBarColor[LIMIT(0, REAL_TO_INT(rPShare / 25.0 - 0.5), 3)];
dwIColor := aBarColor[LIMIT(0, REAL_TO_INT(rIShare / 25.0 - 0.5), 3)];
dwDColor := aBarColor[LIMIT(0, REAL_TO_INT(rDShare / 25.0 - 0.5), 3)];

// 9. Version 2 banner: worst problem wins. Flashes slowly between bright and dark red.
fbFlash(IN := NOT fbFlash.Q, PT := T#600MS);
IF fbFlash.Q THEN
    bFlash := NOT bFlash;
END_IF
IF P_Panel.nState = 3 THEN
    sBanner := 'E-STOP: release it, then cycle Enable';
ELSIF P_Panel.nState = 4 THEN
    sBanner := 'FAN DRIVE FAULT: cycle Enable to reset';
ELSIF P_Loop.bSatAlarm THEN
    sBanner := 'FAN AT LIMIT: ball not reaching setpoint';
ELSIF bFaultActive THEN
    sBanner := 'INSTRUCTOR FAULT ACTIVE';
ELSE
    sBanner := '';
END_IF
bBanner := sBanner <> '';
IF bFlash THEN
    dwBannerFill := 16#FFFF5A4F;
ELSE
    dwBannerFill := 16#FF7A2420;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>