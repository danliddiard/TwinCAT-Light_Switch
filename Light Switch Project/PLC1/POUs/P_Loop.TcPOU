<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="P_Loop" Id="{782d3935-dce7-430b-b03b-5fa34d8c7091}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM P_Loop
// Ball height PID. PV = Prox through EL3002 Ch1. CV = fan % through P_FanTest.
// Runs only when bAuto is TRUE and P_Panel is READY. Otherwise it tracks the fan (bumpless).
// Call order in MAIN: P_Panel(); P_Hmi(); P_Loop(); P_FanTest(); P_FanAO();
// nScenario injects one classic loop fault for teaching (Auto only). The PID doesn't know.
// In Auto, the panel Fan Up / Fan Down buttons move the setpoint instead of the fan.
VAR_INPUT
    // ---- Operator: write these online (later from the HMI) ----
    bAuto       : BOOL;              // TRUE = PID drives the fan (needs panel READY)
    rSP         : REAL := 6.0;       // Setpoint, inches
    rKp         : REAL := 4.0;       // Gain, % fan per inch of error
    rTi         : REAL := 4.0;       // Integral time, s (0 = no integral)
    rTd         : REAL := 0.0;       // Derivative time, s (start at 0)
    rOutMin     : REAL := 0.0;       // Fan low limit, % (raise to just under the lift-off %)
    rOutMax     : REAL := 100.0;     // Fan high limit, %
    bAntiWindup : BOOL := TRUE;      // FALSE only for the windup lab
    bResetIAE   : BOOL;              // Set TRUE to zero the score
    nScenario   : INT;               // Teaching fault: 0 none, 1 dead time, 2 sticky fan, 3 noisy PV, 4 frozen PV, 5 wrong action, 6 weak fan
END_VAR

VAR CONSTANT
    CAL_LAST : INT := 3;   // last point number. Add a point later: bump this, extend both lists
END_VAR

VAR
    // ---- Settings ----
    rSPMin      : REAL := 3.0;       // Lowest setpoint, in
    rSPMax      : REAL := 9.0;       // Highest setpoint, in
    rSPStep     : REAL := 0.5;       // Setpoint change per button press, in
    rCalSlope   : REAL := 1.9;       // h = slope * V + offset (Oct 29 Prox readings)
    rCalOffset  : REAL := 1.3;
	aCalV       : ARRAY[0..CAL_LAST] OF REAL := [1.1, 1.9, 4.2, 5.965];  // Prox volts (Nov 18th, ball center)
    aCalIn      : ARRAY[0..CAL_LAST] OF REAL := [3.0, 6.0, 9.0, 12.0];   // Fatmax tape, inches
    nCalSeg     : INT;    // which pair of points the reading falls between
    i           : INT;
    rFilterS    : REAL := 0.2;       // PV filter time constant, s
    rCycleS     : REAL := 0.01;      // PlcTask cycle, s

    // ---- Readouts ----
    rPVVolts    : REAL;              // Prox voltage
    rPVRaw      : REAL;              // Height before filtering, in
    rPV         : REAL;              // Height, filtered, in
    rError      : REAL;              // SP - PV, in
    rCV         : REAL;              // PID output, fan %
    rP          : REAL;              // P part, %
    rI          : REAL;              // I part, %
    rD          : REAL;              // D part, %
    rIAE        : REAL;              // Score: sum of |error| x time. Lower is better.
    bActive     : BOOL;              // PID is driving the fan right now

    // ---- EL3002 (link this one) ----
    nAI1        AT %I* : INT;        // Term 10 (EL3002) > AI Standard Channel 1 > Value

    // ---- Internal ----
    rPVLast     : REAL;
    rIStep      : REAL;
    rCVTry      : REAL;
    bWasActive  : BOOL;
    fbSPUp      : R_TRIG;
    fbSPDown    : R_TRIG;

    // ---- Fault injection (teaching) ----
    nLastScenario : INT;
    aDelay      : ARRAY[0..299] OF REAL;   // dead-time buffer, one slot per 10 ms scan
    nDelaySteps : INT := 150;          // 150 x 10 ms = 1.5 s extra dead time (max 300)
    nDelayIdx   : INT;
    rStickBand  : REAL := 4.0;         // sticky fan: output moves only after 4 % of change
    rCVHeld     : REAL;
    nSeed       : UDINT := 12345;      // noise generator
    rNoiseAmp   : REAL := 0.4;         // noisy PV: +/- 0.4 in before the filter
    rPVHeld     : REAL;                // frozen PV value
    rWeakFanMax : REAL := 55.0;        // weak fan: real output tops out here, the PID can't see it
    rCVOut      : REAL;                // what actually goes to the fan
    j           : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 0. Teaching faults: reset the injectors when the scenario changes
IF nScenario <> nLastScenario THEN
    FOR j := 0 TO 299 DO
        aDelay[j] := rCV;
    END_FOR
    nDelayIdx := 0;
    rCVHeld := rCV;
    rPVHeld := rPV;
    nLastScenario := nScenario;
END_IF

// 1. PV: raw counts -> volts -> inches, then a light filter
rPVVolts := INT_TO_REAL(nAI1) * 10.0 / 32767.0;   // EL3002: 32767 = +10 V
// Volts to inches: straight line between the two nearest calibration points
nCalSeg := 0;
FOR i := 1 TO CAL_LAST - 1 DO
    IF rPVVolts > aCalV[i] THEN
        nCalSeg := i;
    END_IF
END_FOR
rPVRaw := aCalIn[nCalSeg]
        + (rPVVolts - aCalV[nCalSeg])
        * (aCalIn[nCalSeg + 1] - aCalIn[nCalSeg])
        / (aCalV[nCalSeg + 1] - aCalV[nCalSeg]);

// 1b. Teaching faults on the measurement
IF nScenario = 3 THEN
    nSeed := nSeed * UDINT#1103515245 + UDINT#12345;   // wraps around on purpose
    rPVRaw := rPVRaw + (UDINT_TO_REAL(nSeed MOD 1001) / 500.0 - 1.0) * rNoiseAmp;
ELSIF nScenario = 4 THEN
    rPVRaw := rPVHeld;
END_IF
rPV := rPV + (rPVRaw - rPV) * rCycleS / MAX(rFilterS, rCycleS);

// 2. The PID only runs in Auto while the panel is READY (state 2)
bActive := bAuto AND (P_Panel.nState = 2);

// 3. In Auto, Fan Up / Fan Down move the setpoint
fbSPUp(CLK := bActive AND P_Panel.diFanUp);
fbSPDown(CLK := bActive AND P_Panel.diFanDown);
IF fbSPUp.Q THEN
    rSP := rSP + rSPStep;
END_IF
IF fbSPDown.Q THEN
    rSP := rSP - rSPStep;
END_IF
rSP := LIMIT(rSPMin, rSP, rSPMax);

// 4. PID
rError := rSP - rPV;
IF nScenario = 5 THEN
    rError := -rError;   // wrong action: the loop pushes the wrong way
END_IF
IF bActive THEN
    // First scan in Auto: start from the fan's current value (no bump)
    IF NOT bWasActive THEN
        rI := P_Panel.rFanPct - rKp * rError;
        rPVLast := rPV;
    END_IF

    rP := rKp * rError;
    rD := -rKp * rTd * (rPV - rPVLast) / rCycleS;   // D on PV, so SP changes don't kick

    IF rTi > 0.0 THEN
        rIStep := rKp * rError * rCycleS / rTi;
        rCVTry := rP + rI + rIStep + rD;
        // Anti-windup: stop integrating into a limit
        IF NOT bAntiWindup
           OR ((rCVTry < rOutMax OR rIStep < 0.0) AND (rCVTry > rOutMin OR rIStep > 0.0)) THEN
            rI := rI + rIStep;
        END_IF
    END_IF

    rCV := LIMIT(rOutMin, rP + rI + rD, rOutMax);
    // Teaching faults on the output: what the fan really gets
    rCVOut := rCV;
    IF nScenario = 1 THEN                       // extra dead time
        aDelay[nDelayIdx] := rCV;
        nDelayIdx := nDelayIdx + 1;
        IF nDelayIdx >= LIMIT(1, nDelaySteps, 300) THEN
            nDelayIdx := 0;
        END_IF
        rCVOut := aDelay[nDelayIdx];
    ELSIF nScenario = 2 THEN                    // sticky fan
        IF ABS(rCV - rCVHeld) > rStickBand THEN
            rCVHeld := rCV;
        END_IF
        rCVOut := rCVHeld;
    ELSIF nScenario = 6 THEN                    // weak fan
        rCVOut := MIN(rCV, rWeakFanMax);
    END_IF
    P_FanTest.rManualPct := rCVOut;           // Overrides the panel's fan value
    rIAE := rIAE + ABS(rError) * rCycleS;
ELSE
    // Manual: follow the panel's fan value so the switch to Auto is smooth
    rCV := P_Panel.rFanPct;
    rCVOut := rCV;
    rP := 0.0;
    rD := 0.0;
    rI := rCV;
END_IF

rPVLast := rPV;
bWasActive := bActive;

IF bResetIAE THEN
    rIAE := 0.0;
    bResetIAE := FALSE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>